# Django + gunicorn. Statik fayllar va media nginx konteyneriga
# umumiy disk orqali beriladi (deploy/docker-compose.yml ga qarang).
FROM python:3.12-slim

# Python konteynerda buferlamasin: aks holda `docker compose logs` da
# xabarlar kechikib, nosozlikni kuzatish qiyin bo'ladi.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DJANGO_SETTINGS_MODULE=core.settings

WORKDIR /app

# Pillow uchun kerak bo'ladigan kutubxonalar. `--no-install-recommends`
# ataylab: tasvir kichik qolsin.
# Pillow uchun libjpeg/zlib, zaxira nusxa uchun `pg_dump`.
#
# Debian'ning o'z omborida postgresql-client-15 turadi, server esa 16 —
# `pg_dump` o'zidan YANGI serverga ishlashdan bosh tortadi. Shuning uchun
# PostgreSQL'ning rasmiy ombori qo'shiladi va mos versiya o'rnatiladi.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libjpeg62-turbo zlib1g curl ca-certificates gnupg \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] \
http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-16 \
    && apt-get purge -y gnupg curl && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Bog'liqliklar alohida qatlamda: kod o'zgarganda ular qayta o'rnatilmaydi.
COPY xonim_backend/requirements.lock deploy/requirements-deploy.txt ./
RUN pip install -r requirements.lock -r requirements-deploy.txt

COPY xonim_backend/ /app/
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
# CR belgilarini olib tashlaymiz. `.gitattributes` buni manbada ham
# kafolatlaydi, lekin Windows'dagi nusxadan to'g'ridan-to'g'ri yig'ilsa
# fayl baribir CRLF bilan kelishi mumkin — u holda yadro `/bin/sh\r`
# nomli interpretatorni qidirib, konteyner ko'tarilmaydi.
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh

# Ildiz huquqi bilan ishlamaydi: konteynerdan chiqib ketilsa ham zarar
# cheklangan bo'ladi. Statik va media papkalari shu foydalanuvchiniki.
RUN useradd --system --create-home --uid 10001 xonim \
    && mkdir -p /var/lib/xonim/static /var/lib/xonim/media /var/lib/xonim/backups \
    && chown -R xonim:xonim /app /var/lib/xonim
USER xonim

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
