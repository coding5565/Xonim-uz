# ~/apps/xonim/.env — serverdagi nusxa. Git'ga TUSHMAYDI.
# Har bir qiymatni to'ldiring, so'ng: docker compose up -d --build

# --- Loyiha ---
# PROJECT server bo'yicha yagona bo'lishi shart: konteyner nomlari va
# Traefik marshruti shu nomdan yasaladi.
PROJECT=xonim
# Traefik shu nom bo'yicha marshrutlaydi va sertifikat oladi.
# Domen sotib olinmagan bo'lsa, IP ni ko'rsatuvchi bepul nom ishlatiladi:
#   37-140-216-170.sslip.io
# Haqiqiy domen paydo bo'lganda shu qatorni almashtirish yetarli.
DOMAIN=37-140-216-170.sslip.io

# --- Django ---
# Kamida 50 belgi. Yaratish: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=0
# HTTPS himoyasi (secure cookie, HSTS, HTTP->HTTPS). Sertifikat bo'lmaganda
# va faqat shundagina 0 qilinadi — u holda parollar ochiq matnda yuriladi.
DJANGO_HTTPS=1
DJANGO_ALLOWED_HOSTS=37-140-216-170.sslip.io
CSRF_TRUSTED_ORIGINS=https://37-140-216-170.sslip.io

# --- Baza ---
POSTGRES_DB=xonim
POSTGRES_USER=xonim
POSTGRES_PASSWORD=CHANGE_ME

# --- Chek printeri ---
# Bulutdagi server restoran ichidagi USB printerga YETA OLMAYDI. Ular
# bo'sh qoldiriladi; chek chiqarish faqat restoran ichidagi kompyuterdan
# ishlaydi. Tarmoq printeri tashqaridan ko'rinsa, manzilini yozing.
RECEIPT_PRINTER=
KITCHEN_PRINTER=
RECEIPT_AUTO_PRINT=0

# --- Zaxira nusxa Telegramga ---
# Bot @BotFather da yaratiladi. CHAT_ID ni bilish uchun botga bir marta
# yozing, so'ng: https://api.telegram.org/bot<TOKEN>/getUpdates
# Bo'sh qoldirilsa nusxa baribir olinadi, lekin faqat serverda qoladi.
#
# Bir nechta qabul qiluvchi vergul bilan yoziladi: TELEGRAM_CHAT_ID=111,222
# DIQQAT: har bir odam avval botga /start yozishi SHART — Telegram botga
# birinchi bo'lib yozishga ruxsat bermaydi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Serverdagi nusxalar shuncha kundan keyin o'chiriladi.
BACKUP_KEEP_DAYS=14

# --- AI yordamchi (ixtiyoriy) ---
# Bo'sh qoldirilsa tezkor javoblar ishlaydi, OpenAI chaqirilmaydi.
OPENAI_API_KEY=

# --- gunicorn ---
# Bu VM da RAM ~3GB: 3 ta jarayon xavfsiz chegara.
GUNICORN_WORKERS=3

# Telegram botdagi /backup buyrug'i uchun. Ixtiyoriy maxfiy so'z —
# Telegram uni har so'rovda sarlavhada qaytaradi. Yaratish:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Bo'sh qoldirilsa bot buyruqlarni umuman qabul qilmaydi.
TELEGRAM_WEBHOOK_SECRET=

# --- Chek printeri: bulut + restorandagi agent ---
# direct — printer shu kompyuterga ulangan (restoran ichidagi o'rnatish);
# agent  — server bulutda. Talon navbatga tushadi, restorandagi agent oladi.
PRINT_MODE=agent
# Agent shu so'z bilan taniladi. Yaratish:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PRINT_AGENT_TOKEN=
# Agent topshiriqni olib javob bermasa, shuncha soniyadan keyin navbatga qaytadi.
PRINT_LEASE_SECONDS=120
