# Frontend: Vite bilan yig'iladi, so'ng nginx uni beradi va /api ni
# gunicorn'ga uzatadi. Traefik faqat shu konteynerni ko'radi.

# --- 1-bosqich: yig'ish ---
FROM node:22-alpine AS build
WORKDIR /src

# package-lock.json alohida ko'chiriladi: manba o'zgarganda bog'liqliklar
# qayta yuklanmasin.
COPY xonim_frontend/package.json xonim_frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY xonim_frontend/ ./
RUN npm run build

# --- 1b-bosqich: moliyaviy kalkulyator ---
# Alohida ilova, lekin shu saytning /planner/ manzilida turadi: Xonim
# sessiyasi u yerda ham ishlaydi va alohida login kerak bo'lmaydi.
FROM node:22-alpine AS planner
WORKDIR /src

COPY xonim_planner/package.json xonim_planner/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY xonim_planner/ ./
RUN npm run build:xonim

# --- 2-bosqich: berish ---
FROM nginx:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY --from=planner /src/dist /usr/share/nginx/html/planner
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
